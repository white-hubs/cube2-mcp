{
  "name": "cube2-mcp",
  "version": "0.2.0",
  "description": "Multi-domain MCP bridge for cube business services (alarm, risk-control, ...)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:node": "bun build ./src/index.ts --target=node --bundle --outfile=./dist/cube2-mcp.mjs",
    "dev": "node --env-file=.env --import tsx/esm src/index.ts --transport http",
    "dev:http": "node --env-file=.env --import tsx/esm src/index.ts --transport http",
    "dev:stdio": "node --env-file=.env --import tsx/esm src/index.ts --transport stdio",
    "start": "node --env-file=.env dist/index.js",
    "start:node": "node dist/cube2-mcp.mjs --transport http",
    "start:http": "node --env-file=.env dist/index.js --transport http",
    "start:stdio": "node --env-file=.env dist/index.js --transport stdio",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
