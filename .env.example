# Enabled MCP modules: alarm, risk-control
# If omitted, modules auto-enable when their service URL is configured.
MCP_MODULES=alarm,risk-control

# --- Alarm module ---
ALARM_SERVICE_URL=http://192.168.0.243:3200/alarm/alarm-records/batch-handler
ALARM_SERVICE_TIMEOUT_MS=10000

# --- Risk-control module ---
# Gateway base URL to security-management service (without trailing slash)
RISK_CONTROL_SERVICE_URL=http://192.168.0.243:3200/securitymanagement
RISK_CONTROL_SERVICE_TIMEOUT_MS=15000

# Optional MCP transport. Use http when the agent/client can send request headers.
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_PATH=/mcp
MCP_SERVER_NAME=cube2-mcp

# Optional downstream header names.
MCP_HEADER_TENANT=tenant
MCP_HEADER_AUTHORIZATION=authorization
MCP_HEADER_TERMINAL=terminal

# Optional fallback context for stdio or local fixed deployments.
# Prefer HTTP headers for per-user/per-tenant values.
# MCP_CONTEXT_TENANT=your-tenant
# MCP_CONTEXT_AUTHORIZATION=Bearer your-token
# MCP_CONTEXT_TERMINAL=agent
